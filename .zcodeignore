# ===== Python 字节码 / 缓存(必须)=====
__pycache__/
*.py[cod]
*$py.class
*.so

# ===== 虚拟环境(必须)=====
venv/
.venv/
env/
ENV/

# ===== 打包 / 分发产物 =====
build/
dist/
*.egg-info/
*.egg
pip-wheel-metadata/

# ===== 测试 / 类型检查 / 覆盖率缓存 =====
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/

# ===== 环境变量 / 敏感信息(必须)=====
.env
.env.*
!.env.example

# ===== SSH 密码等敏感配置(必须,模板文件除外)=====
secrets*.json
*.secret.json
!secrets.example.json

# ===== 日志 =====
*.log
logs/

# ===== Flask 实例目录 =====
instance/

# ===== IDE / 编辑器 =====
.idea/
.vscode/
*.swp
*.swo
*.sublime-*

# ===== 操作系统 =====
.DS_Store
Thumbs.db

# ===== Jupyter =====
.ipynb_checkpoints/

# ===== ↑ 以上同步自 .gitignore（「从 .gitignore 同步」只重写以上部分）=====
.git/
.hg/
.svn/
node_modules/
bower_components/
jspm_packages/
site-packages/
coverage/
lcov-report/
cmakefiles/
cmake-build-*/
bazel-*/
pods/
deriveddata/
storybook-static/
playwright-report/
test-results/
allure-results/
allure-report/
cdk.out/
*.dist-info/
eggs/
wheels/
